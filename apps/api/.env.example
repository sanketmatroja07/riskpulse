# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:pass@host:5432/riskpulse

# Auth
JWT_SECRET=your-strong-random-secret-here

# LLM (for AI narratives)
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai

# Redis (Upstash)
REDIS_URL=redis://default:xxx@us1-xxx.upstash.io:6379

# Stripe (billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Observability
SENTRY_DSN=https://xxx@sentry.io/xxx
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=https://riskpulse.io,https://www.riskpulse.io

# Mode
MODE=production

# URLs
BASE_URL=https://api.riskpulse.io
FRONTEND_URL=https://riskpulse.io
