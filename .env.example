# RiskPulse Configuration
# Copy this to .env and fill in values

# LLM Provider: "openai", "anthropic", or "local" (default)
LLM_PROVIDER=local

# Optional: OpenAI API Key (enables GPT-based narrative generation)
OPENAI_API_KEY=

# Optional: Anthropic API Key (enables Claude-based narrative generation)
ANTHROPIC_API_KEY=

# JWT Secret (change in production)
JWT_SECRET=dev-secret-change-in-production-abc123

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql+asyncpg://riskpulse:riskpulse_dev@postgres:5432/riskpulse
REDIS_URL=redis://redis:6379/0
